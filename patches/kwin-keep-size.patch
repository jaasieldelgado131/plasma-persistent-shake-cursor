diff --git a/autotests/integration/effects/shakecursor_test.cpp b/autotests/integration/effects/shakecursor_test.cpp
new file mode 100644
index 0000000..46ccc28
--- /dev/null
+++ b/autotests/integration/effects/shakecursor_test.cpp
@@ -0,0 +1,137 @@
+/*
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "cursor.h"
+#include "effect/effecthandler.h"
+#include "effect/effectloader.h"
+#include "kwin_wayland_test.h"
+#include "scene/item.h"
+#include "scene/workspacescene.h"
+#include "wayland_server.h"
+
+using namespace KWin;
+
+class ShakeCursorTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void initTestCase();
+    void cleanup();
+    void testKeepSize_data();
+    void testKeepSize();
+    void testEnableWhileEnlarged();
+
+private:
+    void shake();
+    qreal scale() const;
+    quint32 m_timestamp = 0;
+};
+
+void ShakeCursorTest::initTestCase()
+{
+    qputenv("XDG_DATA_DIRS", QCoreApplication::applicationDirPath().toUtf8());
+    QVERIFY(waylandServer()->init(qAppName()));
+    auto config = KSharedConfig::openConfig(QString(), KConfig::SimpleConfig);
+    KConfigGroup plugins(config, QStringLiteral("Plugins"));
+    for (const QString &name : EffectLoader().listOfKnownEffects()) {
+        plugins.writeEntry(name + QStringLiteral("Enabled"), false);
+    }
+    config->sync();
+    kwinApp()->setConfig(config);
+    kwinApp()->start();
+    Test::setOutputConfig({Rect(0, 0, 1280, 1024)});
+}
+
+void ShakeCursorTest::cleanup()
+{
+    effects->unloadAllEffects();
+    QVERIFY(!Cursors::self()->isCursorHidden());
+}
+
+void ShakeCursorTest::shake()
+{
+    for (int i = 0; i < 12; ++i) {
+        Test::pointerMotion(QPointF(i % 2 ? 600 : 400, 400), m_timestamp += 20);
+    }
+}
+
+qreal ShakeCursorTest::scale() const
+{
+    for (Item *item : effects->scene()->overlayItem()->childItems()) {
+        if (qstrcmp(item->metaObject()->className(), "KWin::ShakeCursorItem") == 0) {
+            return item->transform().m11();
+        }
+    }
+    return 1.0;
+}
+
+void ShakeCursorTest::testKeepSize_data()
+{
+    QTest::addColumn<int>("keepSize");
+    QTest::newRow("default-still-shrinks") << -1;
+    QTest::newRow("disabled-still-shrinks") << 0;
+    QTest::newRow("enabled-retains-and-can-reset") << 1;
+}
+
+void ShakeCursorTest::testKeepSize()
+{
+    QFETCH(int, keepSize);
+    KConfigGroup config(kwinApp()->config(), QStringLiteral("Effect-shakecursor"));
+    if (keepSize == -1) {
+        config.deleteEntry("KeepSize");
+    } else {
+        config.writeEntry("KeepSize", keepSize == 1);
+    }
+    config.sync();
+    QVERIFY(effects->loadEffect(QStringLiteral("shakecursor")));
+    Effect *effect = effects->findEffect(QStringLiteral("shakecursor"));
+    QVERIFY(effect);
+    shake();
+    QTRY_VERIFY(effect->isActive());
+    QTest::qWait(350);
+    const qreal firstScale = scale();
+    QVERIFY(firstScale > 1.0);
+
+    QTest::qWait(2500);
+    if (keepSize != 1) {
+        QVERIFY(!effect->isActive());
+        QCOMPARE(scale(), 1.0);
+        return;
+    }
+    QVERIFY(effect->isActive());
+    QCOMPARE(scale(), firstScale);
+    shake();
+    QTest::qWait(350);
+    QVERIFY(scale() > firstScale);
+    config.writeEntry("KeepSize", false);
+    config.sync();
+    effect->reconfigure(Effect::ReconfigureAll);
+    QTRY_VERIFY(!effect->isActive());
+    QVERIFY(!Cursors::self()->isCursorHidden());
+}
+
+void ShakeCursorTest::testEnableWhileEnlarged()
+{
+    KConfigGroup config(kwinApp()->config(), QStringLiteral("Effect-shakecursor"));
+    config.writeEntry("KeepSize", false);
+    config.sync();
+    QVERIFY(effects->loadEffect(QStringLiteral("shakecursor")));
+    Effect *effect = effects->findEffect(QStringLiteral("shakecursor"));
+    QVERIFY(effect);
+    shake();
+    QTest::qWait(350);
+    const qreal enlargedScale = scale();
+    QVERIFY(enlargedScale > 1.0);
+    config.writeEntry("KeepSize", true);
+    config.sync();
+    effect->reconfigure(Effect::ReconfigureAll);
+    QTest::qWait(2500);
+    QVERIFY(effect->isActive());
+    QCOMPARE(scale(), enlargedScale);
+    // cleanup() unloads the enlarged effect and verifies that the normal cursor returns.
+}
+
+WAYLANDTEST_MAIN(ShakeCursorTest)
+#include "shakecursor_test.moc"
