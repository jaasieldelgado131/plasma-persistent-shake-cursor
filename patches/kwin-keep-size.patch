     m_shakeDetector.setSensitivity(ShakeCursorConfig::sensitivity());
+
+    const bool keepSize = ShakeCursorConfig::keepSize();
+    if (m_keepSize != keepSize) {
+        m_keepSize = keepSize;
+        m_deflateTimer.stop();
+        if (!m_keepSize) {
+            deflate();
+        } else if (m_targetMagnification < m_currentMagnification) {
+            m_scaleAnimation.stop();
+            m_targetMagnification = m_currentMagnification;
+        }
+    }
 }
 
 void ShakeCursorEffect::inflate()
@@ -122,7 +134,9 @@ void ShakeCursorEffect::pointerMotion(PointerMotionEvent *event)
 
     if (m_shakeDetector.update(event)) {
         inflate();
-        m_deflateTimer.start(2000);
+        if (!m_keepSize) {
+            m_deflateTimer.start(2000);
+        }
     }
 }
 
